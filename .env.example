# Copy to .env for local runs. Never commit .env. In the Anthropic cloud environment, set these as
# environment variables of the cloud environment instead (see docs/SETUP.md).

# Key for the article classifier (Claude Haiku). Deliberately NOT named ANTHROPIC_API_KEY:
# Claude Code would use that name and bill the agent's own work to the API instead of your plan.
LLM_CLASSIFIER_API_KEY=

# Folder of the private data repo (<owner>/<data-repo>). Optional if it is cloned next to this repo.
FML_DATA_DIR=

# Comma-separated private words that must never appear in public files (real names, institution,
# course, team number). Checked by the privacy gate. Keep this out of the repo.
FML_PRIVACY_TERMS=

# Only for running the agent outside an Anthropic cloud session (e.g. a laptop or CI):
# a long-lived subscription token from `claude setup-token`.
CLAUDE_CODE_OAUTH_TOKEN=

# Tests and dry runs: replace Claude with a stub (no usage).
# FML_AGENT_FAKE_LLM=1
