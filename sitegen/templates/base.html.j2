<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title>{% block title %}Reading 9/11 articles two ways{% endblock %}</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600;8..60,700&display=swap" rel="stylesheet">
<style>
:root {
  --paper: #f5f7fa; --ink: #1d2433; --muted: #59647a; --rule: #d6dce6; --cell: #eaeef4;
  --cell-out: #ffffff; --prompt: #7b879c; --link: #2652a0;
  --con: #8c3b76; --main: #2b7a6a; --warn: #a3441f; --focus: #2652a0;
  --serif: "Source Serif 4", Georgia, serif; --mono: "IBM Plex Mono", ui-monospace, monospace;
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --paper: #12161d; --ink: #e5e9f0; --muted: #a2acbd; --rule: #2a3240; --cell: #1a2029;
    --cell-out: #161b23; --prompt: #7d889b; --link: #8db4f5; --con: #d98ac6; --main: #6fc9b6; --warn: #f0926b;
  }
}
:root[data-theme="dark"] {
  --paper: #12161d; --ink: #e5e9f0; --muted: #a2acbd; --rule: #2a3240; --cell: #1a2029;
  --cell-out: #161b23; --prompt: #7d889b; --link: #8db4f5; --con: #d98ac6; --main: #6fc9b6; --warn: #f0926b;
}
* { box-sizing: border-box; }
html { scroll-padding-top: 1.5rem; }
body { margin: 0; background: var(--paper); color: var(--ink); font: 400 1.0625rem/1.65 var(--serif); }
a { color: var(--link); text-underline-offset: 2px; }
a:focus-visible, button:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }
code, pre { font-family: var(--mono); font-size: .86rem; }
:not(pre) > code { background: var(--cell); padding: .05em .3em; border-radius: 3px; }
.con { color: var(--con); font-weight: 600; } .main { color: var(--main); font-weight: 600; }

.layout { display: grid; grid-template-columns: 15.5rem minmax(0, 1fr); gap: 3rem; max-width: 76rem; margin: 0 auto; padding: 0 1.5rem; }
.toc { position: sticky; top: 0; align-self: start; max-height: 100vh; overflow: auto; padding: 2.5rem 0 2rem; font-size: .9rem; }
.toc ol { list-style: none; margin: 0; padding: 0; }
.toc li a { display: block; padding: .3rem 0 .3rem .7rem; border-left: 2px solid var(--rule); color: var(--muted); text-decoration: none; line-height: 1.35; }
.toc li a:hover, .toc li a[aria-current="true"] { color: var(--ink); border-left-color: var(--ink); }
.toc .links { margin-top: 1.5rem; display: grid; gap: .4rem; }
main { padding: 2.5rem 0 6rem; min-width: 0; }

.masthead { padding-bottom: 2rem; border-bottom: 1px solid var(--rule); margin-bottom: 2.5rem; max-width: 46rem; }
.masthead h1 { font-size: clamp(2rem, 4vw, 2.9rem); line-height: 1.12; margin: 0 0 .9rem; font-weight: 700; letter-spacing: -.01em; }
.masthead p { margin: .3rem 0; color: var(--muted); }

.section { margin: 0 0 4.5rem; }
.section > :not(.cell):not(.feedback) { max-width: 44rem; }
.section h2.section-title { font-size: 1.75rem; line-height: 1.2; margin: 0 0 .4rem; }
.section .part { color: var(--muted); margin: 0 0 1rem; font-size: .95rem; }
.section h2 { font-size: 1.2rem; margin: 2rem 0 .5rem; }
.section h3 { font-size: 1.05rem; margin: 1.5rem 0 .4rem; }
.hypothesis { border-left: 3px solid var(--ink); padding: .2rem 0 .2rem 1rem; margin: 1rem 0 1.5rem; font-style: italic; }

.cell { display: grid; grid-template-columns: 5.2rem minmax(0, 1fr); margin: 1.1rem 0; max-width: 58rem; }
.cell .prompt { font: 500 .78rem/1 var(--mono); color: var(--prompt); padding-top: .85rem; text-align: right; padding-right: .8rem; white-space: nowrap; }
.cell-body { min-width: 0; border-radius: 4px; }
.code .cell-body { background: var(--cell); border: 1px solid var(--rule); }
.code figcaption { font: .78rem/1.4 var(--mono); padding: .5rem .9rem 0; color: var(--muted); }
.code figcaption a { color: inherit; }
.code pre { margin: 0; padding: .6rem .9rem .8rem; overflow-x: auto; line-height: 1.5; }
.code.is-long pre { max-height: 32rem; overflow-y: hidden; }
.code.is-long.open pre { max-height: none; }
.expand { font: .8rem var(--mono); background: none; border: 0; border-top: 1px solid var(--rule); width: 100%; padding: .45rem; color: var(--link); cursor: pointer; }
.output .cell-body { background: var(--cell-out); border: 1px solid var(--rule); padding: .8rem .9rem; }
.output img { max-width: 100%; height: auto; display: block; }
.output figcaption { color: var(--muted); font-size: .9rem; margin-top: .5rem; }
.broken .cell-body { border: 1px dashed var(--warn); color: var(--warn); padding: .6rem .9rem; }
.table-wrap { overflow-x: auto; }
table { border-collapse: collapse; font-size: .9rem; }
th, td { padding: .3rem .7rem; border-bottom: 1px solid var(--rule); text-align: left; vertical-align: top; }
td { font-variant-numeric: tabular-nums; }
.note { color: var(--muted); font-size: .85rem; }

.part { max-width: 46rem; margin: 1.6rem 0; }
.part-label { font: 600 .78rem/1 var(--mono); text-transform: uppercase; letter-spacing: .08em; color: var(--muted); margin: 0 0 .7rem !important; }
.part-code { max-width: 58rem; }
.part-report { background: var(--cell-out); border: 1px solid var(--rule); border-left: 4px solid var(--ink); border-radius: 4px; padding: 1.1rem 1.4rem; }
.part-report .part-label::after { content: " — goes into the final report word for word"; text-transform: none; letter-spacing: 0; font-weight: 400; }
.part-report .cell { grid-template-columns: 1fr; } .part-report .cell .prompt { display: none; }
.part-check details { border: 1px solid var(--rule); border-radius: 4px; margin: .5rem 0; padding: .55rem .9rem; background: var(--cell-out); }
.part-check summary { cursor: pointer; font-weight: 600; }
.part-check details[open] summary { margin-bottom: .4rem; }
.part-check details p { margin: .3rem 0; }
a.gl { color: inherit; text-decoration: underline dotted var(--link); text-decoration-thickness: 1.5px; }
a.gl:hover { color: var(--link); }
.feedback { max-width: 58rem; margin: 2.2rem 0 0 5.2rem; border: 1px solid var(--rule); border-radius: 6px; padding: 1.1rem 1.3rem; background: var(--cell-out); }
.feedback h3 { margin: 0 0 .4rem; font-size: 1.05rem; }
.feedback p { margin: .3rem 0; color: var(--muted); font-size: .95rem; }
.feedback ul { margin: .4rem 0 .8rem; padding-left: 1.2rem; font-size: .95rem; }
.feedback button { font: 600 .95rem var(--serif); color: var(--paper); background: var(--ink); border: 0; border-radius: 4px; padding: .5rem 1rem; cursor: pointer; }
.feedback .giscus { margin-top: 1rem; }

/* pygments */
.k,.kn,.kd,.kc,.ow { color: var(--con); } .s,.s1,.s2,.sd,.sa { color: var(--main); }
.c,.c1,.cm { color: var(--prompt); font-style: italic; } .nf,.nc { color: var(--link); } .mi,.mf { color: var(--warn); }

@media (max-width: 860px) {
  .layout { grid-template-columns: 1fr; gap: 0; padding: 0 1rem; }
  .toc { position: static; max-height: none; padding: 1.5rem 0 0; }
  .cell { grid-template-columns: 1fr; } .cell .prompt { text-align: left; padding: 0 0 .3rem; }
  .feedback { margin-left: 0; }
}
@media (prefers-reduced-motion: reduce) { * { scroll-behavior: auto !important; } }
</style>
</head>
<body>
{% block body %}{% endblock %}
</body>
</html>
